<?xml version="1.0"?>
<package format="3">
  <name>rlinf_robotiq_observation</name>
  <version>0.1.0</version>
  <description>Observation-only Robotiq bridge using the existing NUC C++ interface.</description>
  <maintainer email="contact@rlinf.ai">The RLinf Authors</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>rcl_interfaces</depend>
  <depend>diagnostic_msgs</depend>
  <depend>builtin_interfaces</depend>
  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>
  <depend>boost</depend>
  <build_depend>patch</build_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <test_depend>libgtest-dev</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
