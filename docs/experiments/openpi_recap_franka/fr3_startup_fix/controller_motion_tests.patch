+TEST_F(JointImpedanceIKControllerTest, smallNormalizedXRequestProducesSignedTorqueEquilibrium) {
+  activate();
+  const auto start = flange_pose(q);
+  for (const double request : {0.03, -0.03}) {
+    geometry_msgs::msg::Twist input;
+    input.linear.x = request;
+    exercise_input(input, 80);
+    const auto displacement = flange_pose(torque_equilibrium()).p - start.p;
+    EXPECT_NEAR(displacement.x(), 0.007 * request, 2e-6);
+    EXPECT_NEAR(displacement.y(), 0.0, 2e-6);
+    EXPECT_NEAR(displacement.z(), 0.0, 2e-6);
+  }
+}
+
+TEST_F(JointImpedanceIKControllerTest, repeatedRequestFollowsMeasuredPoseWithoutOpenLoopIntegration) {
+  activate();
+  const auto start = flange_pose(q);
+  geometry_msgs::msg::Twist input;
+  input.linear.x = 0.03;
+  exercise_input(input, 80);
+  const auto first_equilibrium = torque_equilibrium();
+  EXPECT_NEAR((flange_pose(first_equilibrium).p - start.p).x(), 0.00021, 2e-6);
+  const auto first_torque = torque;
+  exercise_input(input, 80);
+  for (size_t i = 0; i < 7; ++i)
+    EXPECT_NEAR(torque[i], first_torque[i], 1e-10);
+
+  // Simulate an ideal measured response at the hardware edge, without a physical robot.
+  q = first_equilibrium;
+  exercise_input(input, 80);
+  const auto displacement = flange_pose(torque_equilibrium()).p - start.p;
+  EXPECT_NEAR(displacement.x(), 0.00042, 4e-6);
+  EXPECT_NEAR(displacement.y(), 0.0, 4e-6);
+  EXPECT_NEAR(displacement.z(), 0.0, 4e-6);
+}
