+CallbackReturn JointImpedanceIKController::on_configure(const rclcpp_lifecycle::State&) {
+  active_.store(false);
+  if (ik_timer_)
+    ik_timer_->cancel();
+  // Retain operator-configured collision thresholds; configuring this controller sends no safety
+  // RPC.
+  auto client =
+      std::make_shared<rclcpp::AsyncParametersClient>(get_node(), "robot_state_publisher");
+  if (!client->wait_for_service(std::chrono::seconds(2)))
+    return CallbackReturn::FAILURE;
+  auto future = client->get_parameters({"robot_description"});
+  if (future.wait_for(std::chrono::seconds(2)) != std::future_status::ready)
+    return CallbackReturn::FAILURE;
+  const auto parameters = future.get();
+  if (parameters.empty())
+    return CallbackReturn::FAILURE;
+  std::lock_guard<std::mutex> solver_lock(ik_mutex_);
+  if (!assign_parameters_())
+    return CallbackReturn::FAILURE;
+  urdf::Model model;
+  KDL::Tree tree;
+  const auto description = parameters[0].as_string();
+  if (!model.initString(description) || !kdl_parser::treeFromUrdfModel(model, tree))
+    return CallbackReturn::FAILURE;
+  const auto robot_name =
+      robot_utils::getRobotNameFromDescription(description, get_node()->get_logger());
+  if (robot_name != arm_id_ || !tree.getChain("base", arm_id_ + "_link8", chain_) ||
+      chain_.getNrOfJoints() != 7)
+    return CallbackReturn::FAILURE;
+  q_min_.resize(7);
+  q_max_.resize(7);
+  q_init_.resize(7);
+  q_result_.resize(7);
+  size_t index = 0;
+  for (const auto& segment : chain_.segments) {
+    if (segment.getJoint().getType() == KDL::Joint::None)
+      continue;
+    const auto joint = model.getJoint(segment.getJoint().getName());
+    if (!joint || !joint->limits || !std::isfinite(joint->limits->velocity) ||
+        joint->limits->velocity <= 0 || !std::isfinite(joint->limits->lower) ||
+        !std::isfinite(joint->limits->upper) || joint->limits->lower >= joint->limits->upper)
+      return CallbackReturn::FAILURE;
+    joint_names_[index] = joint->name;
+    q_min_(index) = joint->limits->lower;
+    q_max_(index) = joint->limits->upper;
+    velocity_limits_[index] = joint->limits->velocity;
+    ++index;
+  }
   franka_robot_model_ = std::make_unique<franka_semantic_components::FrankaRobotModel>(
-      franka_semantic_components::FrankaRobotModel(arm_id_ + "/" + k_robot_model_interface_name,
